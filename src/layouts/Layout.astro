---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Nexus — soluciones simples y precisas para personas y negocios. Construidas de a módulos validados." />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		{/*
			Aplica el tema antes del primer paint.

			Tiene que ir acá, en el `<head>`, y con `is:inline`: un `<script>`
			normal de Astro se empaqueta y se ejecuta diferido, o sea DESPUÉS
			de que la página ya se pintó — y eso produce el flash de tema
			equivocado al cargar (medio segundo de negro en modo claro).
			`is:inline` lo deja como está, ejecutándose en el momento.

			Prioridad: lo que el usuario eligió > `prefers-color-scheme` del
			sistema > noche (que es el diseño base).
		*/}
		<script is:inline>
			(function () {
				try {
					var guardado = localStorage.getItem('nexus-theme');
					var sistema = window.matchMedia('(prefers-color-scheme: light)').matches
						? 'light'
						: 'dark';
					document.documentElement.dataset.theme = guardado || sistema;
				} catch (e) {
					/* localStorage bloqueado (modo privado): se queda en noche. */
					document.documentElement.dataset.theme = 'dark';
				}
			})();
		</script>
		<title>{title} | Nexus</title>
	</head>
	<body>
		<slot />
	</body>
</html>
