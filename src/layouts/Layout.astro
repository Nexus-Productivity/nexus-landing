---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const SITE_URL = 'https://nexusthrive.com.co';
const SITE_NAME = 'NEXUS THRIVE';
const DEFAULT_DESCRIPTION =
	'Sitios web y sistemas simples para negocios en Turbaco y Cartagena. Que te encuentren, que te escriban, que sepas cuánto ganas.';
const OG_TITLE =
	'NEXUS THRIVE — Presencia y orden para negocios en Turbaco y Cartagena';
const PAGE_DESCRIPTION =
	`${title} — ${DEFAULT_DESCRIPTION}`;

const CANONICAL = new URL(Astro.url.pathname, SITE_URL);
const OG_IMAGE = new URL('/og-image.webp', SITE_URL);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={PAGE_DESCRIPTION} />
		<link rel="canonical" href={CANONICAL} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:title" content={title === 'Inicio' ? OG_TITLE : `${title} | ${SITE_NAME}`} />
		<meta property="og:description" content={DEFAULT_DESCRIPTION} />
		<meta property="og:url" content={CANONICAL} />
		<meta property="og:image" content={OG_IMAGE} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/webp" />
		<meta property="og:image:alt" content="NEXUS THRIVE — Presencia y orden para negocios en Turbaco y Cartagena." />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title === 'Inicio' ? OG_TITLE : `${title} | ${SITE_NAME}`} />
		<meta name="twitter:description" content={DEFAULT_DESCRIPTION} />
		<meta name="twitter:image" content={OG_IMAGE} />

		<!-- Datos estructurados: Organización -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'LocalBusiness',
			name: SITE_NAME,
			url: SITE_URL,
			description: DEFAULT_DESCRIPTION,
			logo: OG_IMAGE.toString(),
			telephone: '+57-323-745-3913',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Cartagena de Indias',
				addressRegion: 'Bolívar',
				addressCountry: 'CO',
			},
			areaServed: [
				{ '@type': 'City', name: 'Turbaco' },
				{ '@type': 'City', name: 'Cartagena de Indias' },
			],
			inLanguage: 'es',
		})} />
		{/*
			El tema del sitio es CLARO por defecto (decisión del CEO:
			no hay toggle, la web es clara siempre).

			Se fija acá, en el `<head>` y con `is:inline`, antes del
			primer paint, para que no haya flash de otro tema al cargar.
			Se limpia además la preferencia vieja de localStorage para
			que nadie quede atascado en el tema oscuro anterior.
		*/}
		<script is:inline>
			document.documentElement.dataset.theme = 'light';
			try {
				localStorage.removeItem('nexus-theme');
			} catch (e) {
				/* localStorage bloqueado: no pasa nada. */
			}
		</script>
		<title>{title === 'Inicio' ? 'NEXUS THRIVE | Presencia y orden para negocios en Turbaco y Cartagena' : `${title} | NEXUS THRIVE`}</title>

		<!-- Medición básica (Plausible): clics en WhatsApp y envíos del formulario -->
		<script defer data-domain="nexusthrive.com.co" src="https://plausible.io/js/script.js"></script>
		<script is:inline>
			window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
			document.addEventListener('click', function (e) {
				var link = e.target.closest('a[data-cta^="whatsapp"]');
				if (link) window.plausible('whatsapp_click', { props: { origen: link.getAttribute('data-cta') } });
			});
			document.addEventListener('submit', function (e) {
				if (e.target && e.target.id === 'contacto-form') window.plausible('formulario_enviado');
			});
		</script>
	</head>
	<body>
		<slot />

		<!-- Botón flotante de WhatsApp: visible en toda la página, sobre todo en celular -->
		<a
			href="https://wa.me/573237453913?text=Hola%20NEXUS%20THRIVE%2C%20quiero%20mi%20radiograf%C3%ADa%20gratis."
			class="wa-float"
			target="_blank"
			rel="noopener"
			aria-label="Escríbenos por WhatsApp"
			data-cta="whatsapp-flotante"
		>
			<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
		</a>

		<style is:global>
			.wa-float {
				position: fixed;
				right: 1.1rem;
				bottom: 1.1rem;
				z-index: 200;
				display: grid;
				place-items: center;
				width: 54px;
				height: 54px;
				border-radius: 50%;
				background: #25d366;
				color: #fff;
				box-shadow: 0 10px 28px rgba(37, 211, 102, 0.4);
				transition: transform 0.2s ease;
			}
			.wa-float:hover { transform: translateY(-2px); }
			@media (min-width: 901px) {
				.wa-float { right: 1.4rem; bottom: 1.4rem; width: 58px; height: 58px; }
			}
		</style>
	</body>
</html>
