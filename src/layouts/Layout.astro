---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Nexus — soluciones simples y precisas para personas y negocios. Construidas de a módulos validados." />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		{/*
			El tema del sitio es CLARO por defecto (decisión del CEO:
			no hay toggle, la web es clara siempre).

			Se fija acá, en el `<head>` y con `is:inline`, antes del
			primer paint, para que no haya flash de otro tema al cargar.
			Se limpia además la preferencia vieja de localStorage para
			que nadie quede atascado en el tema oscuro anterior.
		*/}
		<script is:inline>
			document.documentElement.dataset.theme = 'light';
			try {
				localStorage.removeItem('nexus-theme');
			} catch (e) {
				/* localStorage bloqueado: no pasa nada. */
			}
		</script>
		<title>{title} | Nexus</title>
	</head>
	<body>
		<slot />
	</body>
</html>
