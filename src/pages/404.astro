---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <main class="nf">
    <div class="nf-container">

      <span class="nf-code">404</span>

      <h1>SYSTEM NOT FOUND</h1>

      <p class="nf-text">
        La página que buscas no existe o fue movida.
        El sistema sigue funcionando — solo esta ruta se perdió.
      </p>

      <a href="/" class="nf-link">
        <span>Volver a NEXUS</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="m11 18-6-6 6-6"></path>
        </svg>
      </a>

    </div>
  </main>
</Layout>

<style>
  .nf {
    min-height: 100svh;

    display: grid;
    place-items: center;

    padding: 8rem var(--gutter) 4rem;
  }

  .nf-container {
    max-width: 520px;

    margin: 0 auto;

    text-align: center;
  }

  .nf-code {
    display: block;

    margin-bottom: 1.2rem;

    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.3em;

    color: var(--accent-text, var(--accent-default));
  }

  .nf-container h1 {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;

    color: var(--text-primary);
  }

  .nf-text {
    margin: 1.2rem 0 2.2rem;

    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.65;

    color: var(--text-secondary);
  }

  .nf-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    min-height: 48px;
    padding: 0 1.4rem;

    border: 1px solid var(--accent-default);
    border-radius: 7px;

    background: var(--accent-default);
    color: #050505;

    font-family: 'Inter', sans-serif;
    font-size: 0.86rem;
    font-weight: 600;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nf-link:hover {
    color: #050505;

    transform: translateY(-2px);

    box-shadow: 0 12px 35px rgba(212, 175, 55, 0.2);
  }
</style>
