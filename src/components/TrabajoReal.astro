---
import caseImageUrl from '../assets/casapozonmuseo-real.webp?url';

// Caso real con captura. Cuando haya más casos, basta agregar
// objetos a este arreglo y la grilla crece sola.
const cases = [
  {
    name: 'Casa Museo El Pozón',
    sector: 'Museo comunitario · Cartagena',
    url: 'https://casapozonmuseo.org',
    image: caseImageUrl,
    summary:
      'Un museo con más de 20 años de historia, pero su información vivía dispersa: documentos en carpetas, fotos sin orden y visitas coordinadas solo por WhatsApp.',
    work: [
      'Sitio completo: institucional, experiencia, saberes y comunidad',
      'Archivo documental con 40 documentos descargables',
      'Galería, eventos y recorrido virtual de los nodos museales',
      'Contacto directo: formulario, botón de WhatsApp y ficha de Google Maps',
    ],
    result:
      'Hoy todo el patrimonio del Pozón está organizado en un solo lugar: los documentos, la galería y las visitas se gestionan desde la web.',
  },
];
---

<section class="trabajo" id="proyectos" aria-labelledby="trabajo-title">
  <div class="trabajo-container">

    <header class="trabajo-header">
      <div class="eyebrow">
        <span class="eyebrow-line"></span>
        Trabajo real
      </div>

      <h2 id="trabajo-title" class="trabajo-title">
        No prometemos:
        <span>mostramos.</span>
      </h2>

      <p class="trabajo-lead">
        Esto es lo que hicimos para un negocio como el tuyo.
        Puedes verlo funcionando, no solo en capturas.
      </p>
    </header>

    <div class="trabajo-list">
      {cases.map((item) => (
        <article class="case-card">

          <div class="case-visual">
            {item.image ? (
              <img src={item.image} alt={`Captura del sitio de ${item.name}`} loading="lazy" />
            ) : (
              /* Marcador hasta tener la captura real del proyecto */
              <div class="case-placeholder" aria-hidden="true">
                <span class="placeholder-bar"></span>
                <span class="placeholder-bar short"></span>
                <div class="placeholder-hero"></div>
                <div class="placeholder-row">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            )}

            <span class="case-live">
              <span class="live-dot"></span>
              Sitio en producción
            </span>
          </div>

          <div class="case-body">
            <span class="case-sector">{item.sector}</span>
            <h3 class="case-name">{item.name}</h3>

            <p class="case-summary">{item.summary}</p>

            <div class="case-work">
              <span class="work-label">Qué se hizo</span>
              <ul role="list">
                {item.work.map((task) => (
                  <li>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                    {task}
                  </li>
                ))}
              </ul>
            </div>

            <p class="case-result">{item.result}</p>

            <a
              href={item.url}
              class="case-link"
              target="_blank"
              rel="noopener"
              data-cta="ver-ejemplo"
            >
              <span>Ver el ejemplo</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7"></path>
                <path d="M8 7h9v9"></path>
              </svg>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .trabajo {
    padding: clamp(5rem, 10vw, 8.5rem) var(--gutter);
  }

  .trabajo-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */

  .trabajo-header {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;

    margin-bottom: 1.2rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .eyebrow-line {
    width: 24px;
    height: 1px;
    background: var(--accent-default);
  }

  .trabajo-title {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;

    color: var(--text-primary);
  }

  .trabajo-title span {
    display: block;
    color: var(--accent-default);
  }

  :global([data-theme='light']) .trabajo-title span {
    color: var(--accent-text, #80651d);
  }

  .trabajo-lead {
    margin: 1.2rem 0 0;

    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.65;

    color: var(--text-secondary);
  }

  /* ---------- Caso ---------- */

  .trabajo-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;

    border: 1px solid var(--border-default);
    border-radius: 16px;

    background: var(--bg-surface, rgba(255, 255, 255, 0.02));

    overflow: hidden;

    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .case-card:hover {
    border-color: rgba(212, 175, 55, 0.35);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
  }

  /* ---------- Visual ---------- */

  .case-visual {
    position: relative;

    min-height: 320px;

    border-right: 1px solid var(--border-default);

    background:
      radial-gradient(
        ellipse at 30% 20%,
        rgba(212, 175, 55, 0.08),
        transparent 60%
      );
  }

  .case-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Marcador mientras no hay captura real */
  .case-placeholder {
    position: absolute;
    inset: 2rem;

    display: flex;
    flex-direction: column;
    gap: 0.9rem;

    padding: 1.4rem;

    border: 1px solid var(--border-default);
    border-radius: 12px;

    background: var(--bg-deep, rgba(0, 0, 0, 0.25));
  }

  .placeholder-bar {
    width: 55%;
    height: 8px;

    border-radius: 999px;

    background: var(--border-default);
  }

  .placeholder-bar.short {
    width: 32%;
  }

  .placeholder-hero {
    flex: 1;

    border-radius: 8px;

    background:
      linear-gradient(
        135deg,
        rgba(212, 175, 55, 0.16),
        rgba(212, 175, 55, 0.03)
      );
  }

  .placeholder-row {
    display: flex;
    gap: 0.7rem;
  }

  .placeholder-row span {
    flex: 1;
    height: 26px;

    border-radius: 6px;

    background: var(--border-default);
  }

  .case-live {
    position: absolute;
    top: 1rem;
    right: 1rem;

    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    padding: 5px 10px;

    border: 1px solid var(--border-default);
    border-radius: 999px;

    background: var(--bg-primary);

    font-family: 'Inter', sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: var(--text-secondary);
  }

  .live-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #4ade80;

    box-shadow: 0 0 8px rgba(74, 222, 128, 0.8);
  }

  /* ---------- Cuerpo ---------- */

  .case-body {
    display: flex;
    flex-direction: column;

    padding: clamp(1.6rem, 3vw, 2.4rem);
  }

  .case-sector {
    margin-bottom: 0.5rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .case-name {
    margin: 0 0 0.9rem;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;

    color: var(--text-primary);
  }

  .case-summary {
    margin: 0 0 1.4rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.65;

    color: var(--text-secondary);
  }

  .case-work {
    padding: 1.1rem 0;
    margin-bottom: 1.2rem;

    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
  }

  .work-label {
    display: block;

    margin-bottom: 0.7rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    color: var(--text-muted);
  }

  .case-work ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .case-work li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.83rem;
    line-height: 1.5;

    color: var(--text-secondary);
  }

  .case-work svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--accent-default);
  }

  .case-result {
    margin: 0 0 1.6rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    line-height: 1.65;
    font-style: italic;

    color: var(--text-primary);
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;

    width: fit-content;

    margin-top: auto;

    padding: 0.7rem 1.2rem;

    border: 1px solid var(--border-default);
    border-radius: 7px;

    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;

    color: var(--text-primary);

    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .case-link:hover {
    border-color: var(--accent-default);
    color: var(--accent-text, var(--accent-default));
    transform: translateY(-2px);
  }

  .case-link svg {
    transition: transform 0.2s ease;
  }

  .case-link:hover svg {
    transform: translate(2px, -2px);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 860px) {
    .case-card {
      grid-template-columns: 1fr;
    }

    .case-visual {
      min-height: 240px;

      border-right: none;
      border-bottom: 1px solid var(--border-default);
    }
  }
</style>
