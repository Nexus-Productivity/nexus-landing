---
const WHATSAPP = '573237453913';

const waText = encodeURIComponent(
  'Hola NEXUS THRIVE, quiero mi radiografía gratis.'
);
const waHref = `https://wa.me/${WHATSAPP}?text=${waText}`;
---

<section class="cierre" aria-labelledby="cierre-title">
  <div class="cierre-container">

    <div class="cierre-glow" aria-hidden="true"></div>

    <h2 id="cierre-title" class="cierre-title">
      Tu negocio puede estar
      <span>visible y conectado.</span>
    </h2>

    <p class="cierre-text">
      Un mensaje es todo lo que toma empezar.
    </p>

    <div class="cierre-actions">
      <a
        href={waHref}
        class="cierre-button"
        target="_blank"
        rel="noopener"
        data-cta="whatsapp-cierre"
      >
        <span>Pedir mi radiografía gratis</span>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </a>

      <a href="mailto:hola@nexusthrive.com.co" class="cierre-mail">
        hola@nexusthrive.com.co
      </a>
    </div>

  </div>
</section>

<style>
  .cierre {
    position: relative;

    padding: clamp(6rem, 12vw, 10rem) var(--gutter);

    overflow: hidden;

    isolation: isolate;
  }

  .cierre-container {
    position: relative;

    max-width: 760px;

    margin: 0 auto;

    text-align: center;
  }

  .cierre-glow {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 640px;
    height: 640px;

    transform: translate(-50%, -50%);

    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.12),
      transparent 62%
    );

    z-index: -1;

    pointer-events: none;
  }

  .cierre-title {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;

    color: var(--text-primary);
  }

  .cierre-title span {
    display: block;

    color: var(--accent-default);

    text-shadow:
      0 0 35px var(--glow-text, rgba(212, 175, 55, 0.3)),
      0 0 80px var(--glow-text, rgba(212, 175, 55, 0.3));
  }

  :global([data-theme='light']) .cierre-title span {
    color: var(--accent-text, #80651d);
    text-shadow: none;
  }

  .cierre-text {
    margin: 1.4rem 0 2.4rem;

    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    line-height: 1.6;

    color: var(--text-secondary);
  }

  .cierre-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .cierre-button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    min-height: 52px;
    padding: 0 1.6rem;

    border: 1px solid var(--accent-default);
    border-radius: 7px;

    background: var(--accent-default);
    color: #050505;

    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cierre-button:hover {
    color: #050505;
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(212, 175, 55, 0.25);
  }

  .cierre-button svg {
    transition: transform 0.2s ease;
  }

  .cierre-button:hover svg {
    transform: translateX(3px);
  }

  .cierre-mail {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;

    color: var(--text-secondary);

    transition: color 0.2s ease;
  }

  .cierre-mail:hover {
    color: var(--accent-text, var(--accent-default));
  }
</style>
