---
import { faq } from '../data/oferta';
import { whatsappUrl } from '../data/contacto';
---

<section class="faq" id="faq">
  <div class="container faq-grid">
    <div class="faq-head" data-reveal="sube">
      <span class="eyebrow">04 — Preguntas</span>
      <h2 class="section-title">Las dudas que casi siempre aparecen.</h2>
      <p class="section-lead">
        Si la tuya no está, escribinos y la respondemos directo.
      </p>
      <a class="btn btn-outline faq-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Preguntar por WhatsApp
      </a>
    </div>

    <div class="faq-lista" data-reveal="stagger">
      {
        faq.map((item, i) => (
          <details class="faq-item" name="faq" open={i === 0}>
            <summary class="faq-summary">
              <span>{item.pregunta}</span>
              <svg class="faq-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-respuesta">
              <div>
                <p>{item.respuesta}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: clamp(4rem, 9vw, 7.5rem) 0;
    background-color: var(--bg-subtle);
    border-bottom: 1px solid var(--border-default);
  }

  .faq-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .faq-head .section-title {
    margin-top: 1rem;
  }

  .faq-head .section-lead {
    margin-top: 1.1rem;
  }

  .faq-cta {
    margin-top: 1.75rem;
  }

  .faq-lista {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--border-strong);
  }

  .faq-item[open] {
    border-color: var(--accent-default);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Safari agrega un marcador propio: hay que sacarlo */
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: -2px;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--accent-ink);
    transition: transform 0.25s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-respuesta {
    /* Animación de altura SIN JavaScript y sin conocer el alto real:
       `grid-template-rows` de 0fr a 1fr interpola smoothly porque el
       navegador calcula el fr en cada frame. Es la forma moderna de
       reemplazar el clásico `max-height: 9999px`, que es una mentira
       que produce un final de la animación a velocidad distinta. */
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.38s var(--ease-out);
  }

  .faq-item[open] .faq-respuesta {
    grid-template-rows: 1fr;
  }

  /* El hijo interno es el que se recorta: sin `min-height: 0` el
     fr no puede bajar de su contenido y el colapso no ocurre. */
  .faq-respuesta > div {
    overflow: hidden;
    min-height: 0;
  }

  /* Navegadores sin soporte: se muestra de golpe. Un acordeón que se
     abre al instante es mejor que uno que se abre a destiempo. */
  @supports not (grid-template-rows: 0fr) {
    .faq-respuesta {
      display: block;
      transition: none;
    }

    .faq-item[open] .faq-respuesta {
      animation: aparecer 0.28s ease both;
    }
  }

  /* El `<p>` NO lleva padding lateral: el summary sí (1.35rem), y sin
     esto el texto de la respuesta quedaba pegado al borde del cuadro
     con 1px de aire mientras la pregunta tenía 23 — se leía como que la
     respuesta se había salido de la caja. El aire va en el `<p>`, que es
     el hijo directo del div recortado. */
  .faq-respuesta p {
    padding: 0 1.35rem 1.35rem 1.35rem;
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 60ch;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>