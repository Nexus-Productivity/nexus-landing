---
import { whatsappUrl, whatsappTextoBoton, ciudad } from '../data/contacto';
---

<section class="gradiente-fondo contacto" id="contacto">
  <div class="container contacto-grid">
    <div class="contacto-texto" data-reveal="sube">
      <span class="eyebrow">05 — Contacto</span>
      <h2 class="section-title">Contanos tu caso y armamos la ruta para vos.</h2>
      <p class="section-lead">
        No es un formulario que nadie lee. Con lo que nos escribas armamos la
        conversación: qué te está costando tiempo ahora y por dónde conviene
        empezar.
      </p>

      <a class="btn btn-whatsapp contacto-wa" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.8-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5v-.5c0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2" />
        </svg>
        {whatsappTextoBoton}
      </a>

      <p class="contacto-ciudad">{ciudad}</p>
    </div>

    <form class="formulario" id="form-contacto" data-reveal="sube">
      <p class="formulario-nota">
        Al enviar se abre WhatsApp con tu mensaje escrito. No se guarda nada en
        servidores.
      </p>

      <div class="campo">
        <label for="nombre">Tu nombre</label>
        <input id="nombre" name="nombre" type="text" autocomplete="name" placeholder="¿Cómo te llamás?" required />
      </div>

      <div class="campo">
        <label for="negocio">Tu negocio</label>
        <input id="negocio" name="negocio" type="text" placeholder="Nombre y a qué se dedica" required />
      </div>

      <div class="campo">
        <label for="problema">¿Qué te está costando tiempo ahora?</label>
        <textarea
          id="problema"
          name="problema"
          rows="4"
          placeholder="Ej: no me encuentran en Google, y mi tarifario está en un PDF que nadie abre."
          required
        ></textarea>
      </div>

      <button class="btn btn-primary formulario-boton" type="submit">
        Abrir WhatsApp con el mensaje
      </button>
    </form>
  </div>
</section>

<style>
  .contacto {
    padding: clamp(4rem, 9vw, 7.5rem) 0;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-default);
  }

  .contacto-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }

  /* Cada columna puede encogerse por debajo del contenido. Sin esto, el
     input con `size=20` define el ancho mínimo de la columna y el grid
     se pasa del viewport en pantallas angostas. */
  .contacto-grid > * {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .contacto-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .contacto-texto .section-title {
    margin-top: 1rem;
  }

  .contacto-texto .section-lead {
    margin-top: 1.1rem;
  }

  .contacto-wa {
    margin-top: 2rem;
  }

  .contacto-ciudad {
    margin-top: 1.1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* --- Formulario --- */
  .formulario {
    padding: 1.75rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-default);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;

    /* `min-width: 0` en un item de flex/grid es lo que permite que se
       encoja por debajo de su ancho de contenido. Sin esto, el `<input>`
       (que trae un `size=20` implícito, unos 180px de ancho intrínseco)
       empuja la caja del formulario a ~342px, y como el formulario está
       dentro de un grid, esa columna se desborda del viewport. A 320px
       la página entera quedaba scrolleable en horizontal y el formulario
       se salía de la pantalla. */
    min-width: 0;
  }

  .formulario-nota {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .campo label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .campo input,
  .campo textarea {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    color: var(--text-primary);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;

    /* `width: 100%` + `min-width: 0`: un input trae `size=20` por
       defecto, o sea un ancho intrínseco de ~180px que no cede. Sin
       esto el campo no baja del tamaño de su contenido y a 320px
       empuja el formulario entero fuera de la pantalla. */
    width: 100%;
    min-width: 0;
  }

  .campo textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.55;
  }

  .campo input::placeholder,
  .campo textarea::placeholder {
    color: var(--text-muted);
  }

  /* El borde de foco usa --accent-ink y no --accent-default: el dorado
     puro queda en 2.1:1 contra blanco y los indicadores de foco
     necesitan 3:1. Se redeclara el radio porque el outline global
     usa 4px y el campo tiene 8px. */
  .campo input:focus,
  .campo textarea:focus {
    border-color: var(--accent-ink);
    box-shadow: var(--glow-accent);
    border-radius: 8px;
  }

  .formulario-boton {
    align-self: flex-start;
    max-width: 100%;

    /* `.btn` trae `white-space: nowrap`, pensado para que "Abrir
       WhatsApp" nunca parta en dos renglones en escritorio. A 320px el
       botón queda más ancho que la caja del formulario (284px contra
       216px útiles) y lo empuja fuera de la pantalla. Acá sí se
       permite partir: es preferible un botón de dos renglones que un
       formulario que no entra. */
    white-space: normal;
    text-align: center;
  }

  @media (min-width: 480px) {
    .formulario-boton {
      white-space: nowrap;
    }
  }
</style>

<script>
  import { whatsappNumero } from '../data/contacto';

  const form = document.getElementById('form-contacto') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const datos = new FormData(form);
    const nombre = String(datos.get('nombre') ?? '').trim();
    const negocio = String(datos.get('negocio') ?? '').trim();
    const problema = String(datos.get('problema') ?? '').trim();

    if (!nombre || !negocio || !problema) return;

    const mensaje = [
      `Hola, te escribo desde la web de NEXUS.`,
      ``,
      `Soy ${nombre} y mi negocio es ${negocio}.`,
      ``,
      `Lo que me está costando tiempo ahora: ${problema}`,
    ].join('\n');

    const url = `https://wa.me/${whatsappNumero}?text=${encodeURIComponent(mensaje)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>