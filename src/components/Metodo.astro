---
const principios = [
  {
    numero: "01",
    titulo: "Simplicidad",
    texto: "Lo esencial, nada más. La complejidad se gana, no se asume.",
  },
  {
    numero: "02",
    titulo: "Verdad",
    texto: "Los hechos antes que la opinión. Observamos antes de construir.",
  },
  {
    numero: "03",
    titulo: "Acción",
    texto: "La teoría no resuelve nada. Construimos, probamos, ajustamos.",
  },
  {
    numero: "04",
    titulo: "Autonomía",
    texto: "Cada herramienta funciona sola. Ninguna depende de la otra.",
  },
];
---

<section class="section-metodo" id="metodo">
  <div class="metodo-content">
    <span class="section-metodo-top-text">03 - Método</span>
    <h2>Cómo pensamos</h2>
    <p>Cuatro principios no negociables detrás de cada decisión.</p>

    <div class="metodo-lista">
      {
        principios.map((item, index) => (
          <>
            <div class="metodo-item">
              <span class="metodo-numero">{item.numero}</span>
              <div class="metodo-item-text">
                <label>{item.titulo}</label>
                <p>{item.texto}</p>
              </div>
            </div>
            {index < principios.length - 1 && (
              <div class="metodo-conector" aria-hidden="true"></div>
            )}
          </>
        ))
      }
    </div>
  </div>

  <div class="metodo-grid-n">
    <div class="metodo-grid-n-stage">
      <span>N</span>
    </div>
  </div>
</section>

<style>
  .section-metodo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    margin: 0 auto;
    max-width: 1400px;
    /* Más aire abajo para separar del módulo siguiente */
    padding: 6rem 2rem 9rem;
  }

  .section-metodo-top-text {
    display: block;
    font-family: "Roboto Mono", monospace;
    font-size: 0.85rem;
    color: var(--accent-default);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .metodo-content h2 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .metodo-content > p {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    color: var(--text-secondary, #a0a0a0);
    margin-bottom: 3rem;
  }

  .metodo-lista {
    display: flex;
    flex-direction: column;
  }

  .metodo-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .metodo-numero {
    font-family: "Roboto Mono", monospace;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-default);
    opacity: 0.6;
    min-width: 2.5rem;
    line-height: 1.3;
    transition: opacity 0.3s ease;
  }

  .metodo-item:hover .metodo-numero {
    opacity: 1;
  }

  .metodo-item-text label {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }

  .metodo-item-text p {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary, #a0a0a0);
    margin: 0;
  }

  .metodo-conector {
    width: 1px;
    height: 2rem;
    background-color: var(--border-default);
    margin-left: calc(2.5rem + 0.75rem);
  }

  /* --- La "N" decorativa --- */
  .metodo-grid-n {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .metodo-grid-n-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: min(24rem, 100%);
    aspect-ratio: 1 / 1;
    border: 1px solid var(--border-default);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 50% 38%, rgba(212, 175, 55, 0.14), transparent 62%),
      var(--bg-surface);
    box-shadow:
      0 8px 40px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  /* Estrellas doradas — constelación, estética Nexus */
  .metodo-grid-n-stage::before,
  .metodo-grid-n-stage::after {
    content: "✦";
    position: absolute;
    color: var(--accent-default);
    font-size: 1.15rem;
    line-height: 1;
    opacity: 0.9;
    text-shadow: 0 0 12px rgba(212, 175, 55, 0.8);
  }

  .metodo-grid-n-stage::before {
    top: 1.5rem;
    left: 1.75rem;
  }

  .metodo-grid-n-stage::after {
    right: 1.75rem;
    bottom: 1.5rem;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .metodo-grid-n-stage span {
    font-family: "Public Stunt", sans-serif;
    font-size: clamp(7rem, 15vw, 13rem);
    font-weight: 700;
    line-height: 1;
    color: #ffffff;
    display: block;

    filter: drop-shadow(0 0 30px rgba(212, 175, 55, 0.45))
            drop-shadow(0 0 70px rgba(212, 175, 55, 0.2));
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .section-metodo {
      grid-template-columns: 1fr;
      padding: 4rem 1.5rem 6rem;
      text-align: center;
    }

    .metodo-item {
      text-align: left;
    }

    .metodo-grid-n {
      order: -1;
      margin-bottom: 1.5rem;
    }

    .metodo-grid-n-stage {
      width: min(17rem, 100%);
    }

    .metodo-grid-n-stage span {
      font-size: clamp(4rem, 24vw, 6.5rem);
    }
  }
</style>