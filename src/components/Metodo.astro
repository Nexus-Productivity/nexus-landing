---
const pasos = [
  {
    n: '01',
    name: 'Escuchamos',
    text: 'Nos cuentas tu negocio por WhatsApp o en una llamada corta. Sin formularios eternos ni jerga técnica.',
    detail: 'Tú hablas, nosotros tomamos nota.',
  },
  {
    n: '02',
    name: 'Propuesta cerrada',
    text: 'Te enviamos una propuesta escrita: qué se hará, en cuánto tiempo y a qué precio. Ese precio no se mueve.',
    detail: 'Todo por escrito antes de pagar un peso.',
  },
  {
    n: '03',
    name: 'Construimos',
    text: 'Trabajamos y te mostramos avances. Tienes 2 rondas de ajustes incluidas para dejarlo como lo quieres.',
    detail: 'Avances visibles, no promesas.',
  },
  {
    n: '04',
    name: 'Entregamos y cuidamos',
    text: 'Te entregamos todo a tu nombre: dominio, accesos y archivos. Y si quieres, lo seguimos cuidando.',
    detail: 'El dominio y el sitio son tuyos. Siempre.',
  },
];
---

<section class="metodo" id="metodo" aria-labelledby="metodo-title">
  <div class="metodo-container">

    <header class="metodo-header">
      <div class="eyebrow">
        <span class="eyebrow-line"></span>
        Cómo trabajamos
      </div>

      <h2 id="metodo-title" class="metodo-title">
        Qué pasa después
        <span>de decir que sí.</span>
      </h2>

      <p class="metodo-lead">
        Cuatro pasos, sin sorpresas. Siempre sabes
        en qué va tu proyecto y qué sigue.
      </p>
    </header>

    <ol class="metodo-steps" role="list">
      {pasos.map((paso, i) => (
        <li class="step-item">
          {i < pasos.length - 1 && (
            <span class="step-connector" aria-hidden="true"></span>
          )}

          <span class="step-number">{paso.n}</span>

          <div class="step-body">
            <h3>{paso.name}</h3>
            <p class="step-text">{paso.text}</p>
            <span class="step-detail">{paso.detail}</span>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .metodo {
    padding: clamp(5rem, 10vw, 8.5rem) var(--gutter);
  }

  .metodo-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */

  .metodo-header {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;

    margin-bottom: 1.2rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .eyebrow-line {
    width: 24px;
    height: 1px;
    background: var(--accent-default);
  }

  .metodo-title {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;

    color: var(--text-primary);
  }

  .metodo-title span {
    display: block;
    color: var(--accent-default);
  }

  :global([data-theme='light']) .metodo-title span {
    color: var(--accent-text, #80651d);
  }

  .metodo-lead {
    margin: 1.2rem 0 0;

    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.65;

    color: var(--text-secondary);
  }

  /* ---------- Pasos ---------- */

  .metodo-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;

    margin: 0;
    padding: 0;

    list-style: none;

    counter-reset: paso;
  }

  .step-item {
    position: relative;

    display: flex;
    flex-direction: column;

    padding: 1.7rem 1.5rem;

    border: 1px solid var(--border-default);
    border-radius: 14px;

    background: var(--bg-surface, rgba(255, 255, 255, 0.02));

    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .step-item:hover {
    border-color: rgba(212, 175, 55, 0.35);
    transform: translateY(-3px);
  }

  .step-connector {
    position: absolute;
    top: 2.35rem;
    right: -1rem;

    width: 1rem;
    height: 1px;

    background: linear-gradient(
      90deg,
      rgba(212, 175, 55, 0.5),
      rgba(212, 175, 55, 0.1)
    );
  }

  .step-number {
    display: grid;
    place-items: center;

    width: 42px;
    height: 42px;

    margin-bottom: 1.2rem;

    border: 1px solid var(--accent-default);
    border-radius: 50%;

    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;

    color: var(--accent-text, var(--accent-default));

    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .step-item:hover .step-number {
    background: var(--accent-default);
    color: #050505;
  }

  .step-body h3 {
    margin: 0 0 0.6rem;

    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;

    color: var(--text-primary);
  }

  .step-text {
    margin: 0 0 1rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.84rem;
    line-height: 1.6;

    color: var(--text-secondary);
  }

  .step-detail {
    display: block;

    margin-top: auto;
    padding-top: 0.9rem;

    border-top: 1px dashed var(--border-default);

    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    font-style: italic;

    color: var(--accent-text, var(--accent-default));
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1024px) {
    .metodo-steps {
      grid-template-columns: repeat(2, 1fr);
      max-width: 720px;
      margin: 0 auto;
    }

    .step-connector {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .metodo-steps {
      grid-template-columns: 1fr;
      max-width: 440px;
    }
  }
</style>
