---
import { metodo, loQueNoPrometemos } from '../data/oferta';
---

<section class="gradiente-fondo metodo" id="metodo">
  <div class="container">
    <div class="metodo-head" data-reveal="sube">
      <span class="eyebrow">02 — Método</span>
      <h2 class="section-title">
        Primero entendemos el problema. Después construimos la solución.
      </h2>
      <p class="section-lead">
        Por eso lo primero que hacemos es hacerte preguntas, no mostrarte un
        catálogo. Cuatro pasos, sin sorpresas.
      </p>
    </div>

    <ol class="pasos" data-reveal="stagger">
      {
        metodo.map((item) => (
          <li class="paso">
            <span class="paso-numero">{item.paso}</span>
            <h3 class="paso-titulo">{item.titulo}</h3>
            <p class="paso-texto">{item.texto}</p>
          </li>
        ))
      }
    </ol>

    <aside class="no-prometemos superficie-oro" data-reveal="sube">
      <h3 class="no-prometemos-titulo">Lo que no prometemos</h3>
      <ul class="no-prometemos-lista">
        {
          loQueNoPrometemos.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .metodo {
    padding: clamp(4rem, 9vw, 7.5rem) 0;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-default);
  }

  .metodo-head {
    max-width: 60ch;
  }

  .metodo-head .section-title {
    margin-top: 1rem;
  }

  .metodo-head .section-lead {
    margin-top: 1.1rem;
  }

  .pasos {
    margin-top: 3.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 620px) {
    .pasos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .pasos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .paso {
    position: relative;
    padding-top: 1.5rem;
    border-top: 2px solid var(--accent-default);
  }

  .paso-numero {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--accent-ink);
  }

  .paso-titulo {
    margin-top: 0.6rem;
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .paso-texto {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* --- Lo que no prometemos --- */
  .no-prometemos {
    margin-top: 3.5rem;
    padding: 1.5rem 1.75rem;
    background-color: var(--bg-deep);
    color: var(--text-invert);
    border-radius: 14px;
  }

  .no-prometemos-titulo {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-default);
  }

  .no-prometemos-lista {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.8rem;
  }

  @media (min-width: 760px) {
    .no-prometemos-lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .no-prometemos-lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  .no-prometemos-lista svg {
    flex-shrink: 0;
    margin-top: 0.28em;
    color: var(--accent-default);
  }
</style>