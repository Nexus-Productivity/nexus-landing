---
const pains = [
  {
    title: 'Te buscan y no te encuentran',
    text: 'Tienes clientes potenciales buscándote en Google y Maps ahora mismo. Si no apareces, aparece otro.',
  },
  {
    title: 'Tu tarifario está en un PDF',
    text: 'Cada vez que alguien pregunta precios, mandas el mismo archivo por WhatsApp y cruzas los dedos.',
  },
  {
    title: 'No sabes cuánto ganaste',
    text: 'La plata entra por aquí y por allá, y a fin de mes toca adivinar cómo le fue al negocio.',
  },
  {
    title: 'Publicas cuando puedes',
    text: 'Las redes quedan para el final del día, cuando ya no queda energía. Y se nota.',
  },
];
---

<section class="dolores" id="dolores" aria-labelledby="dolores-title">
  <div class="dolores-container">

    <header class="dolores-header">
      <div class="eyebrow">
        <span class="eyebrow-line"></span>
        El problema
      </div>

      <h2 id="dolores-title" class="dolores-title">
        ¿Te suena <span>familiar?</span>
      </h2>

      <p class="dolores-lead">
        No es que te falte empeño. Es que el negocio creció
        y las herramientas se quedaron atrás.
      </p>
    </header>

    <ul class="dolores-grid" role="list">
      {pains.map((pain, i) => (
        <li class="pain-card">
          <span class="pain-number">{String(i + 1).padStart(2, '0')}</span>
          <h3>{pain.title}</h3>
          <p>{pain.text}</p>
        </li>
      ))}
    </ul>

    <p class="dolores-close">
      Si marcaste al menos dos, esta página es para ti.
    </p>

  </div>
</section>

<style>
  .dolores {
    padding: clamp(5rem, 10vw, 8.5rem) var(--gutter);
  }

  .dolores-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */

  .dolores-header {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;

    margin-bottom: 1.2rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .eyebrow-line {
    width: 24px;
    height: 1px;
    background: var(--accent-default);
  }

  .dolores-title {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;

    color: var(--text-primary);
  }

  .dolores-title span {
    color: var(--accent-default);
  }

  :global([data-theme='light']) .dolores-title span {
    color: var(--accent-text, #80651d);
  }

  .dolores-lead {
    margin: 1.2rem 0 0;

    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.65;

    color: var(--text-secondary);
  }

  /* ---------- Grid ---------- */

  .dolores-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .pain-card {
    position: relative;

    padding: 1.6rem 1.5rem 1.5rem;

    border: 1px solid var(--border-default);
    border-radius: 14px;

    background: var(--bg-surface, rgba(255, 255, 255, 0.02));

    overflow: hidden;

    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .pain-card::before {
    content: '';

    position: absolute;
    top: 0;
    left: 0;

    width: 100%;
    height: 2px;

    background: linear-gradient(
      90deg,
      var(--accent-default),
      transparent
    );

    opacity: 0;

    transition: opacity 0.25s ease;
  }

  .pain-card:hover {
    border-color: rgba(212, 175, 55, 0.35);
    transform: translateY(-3px);
  }

  .pain-card:hover::before {
    opacity: 1;
  }

  .pain-number {
    display: block;

    margin-bottom: 0.9rem;

    font-family: 'Roboto Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;

    color: var(--accent-text, var(--accent-default));
  }

  .pain-card h3 {
    margin: 0 0 0.55rem;

    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;

    color: var(--text-primary);
  }

  .pain-card p {
    margin: 0;

    font-family: 'Inter', sans-serif;
    font-size: 0.87rem;
    line-height: 1.6;

    color: var(--text-secondary);
  }

  /* ---------- Cierre ---------- */

  .dolores-close {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: center;

    color: var(--text-secondary);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 720px) {
    .dolores-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
