---
const navItems = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Filosofía', href: '#mision' },
  { label: 'Método', href: '#metodo' },
  { label: 'Escuchamos', href: '#escuchanos' },
];
---

<header class="navbar">
  <div class="navbar-container">

    <!-- Logo -->
    <a href="/" class="navbar-logo" aria-label="NEXUS THRIVE">
      <span class="logo">
        <span class="text-logo-nexus">N</span>
        <span class="sub-text-logo-nexus">THRIVE</span>
      </span>
    </a>

    <!-- Acciones -->
    <div class="navbar-actions">

      <!-- Navegación -->
      <nav class="navbar-nav" aria-label="Navegación principal">

        <input
          type="checkbox"
          id="menu-toggle"
          class="menu-toggle"
          aria-hidden="true"
        />

        <label
          for="menu-toggle"
          class="menu-icon"
          aria-label="Abrir menú"
        >
          <span></span>
          <span></span>
          <span></span>
        </label>

        <ul class="nav-menu">
          {navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}

          <li>
            <a href="#proyectos" class="button">
              Explorar proyectos
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>

      </nav>

      <!-- Theme toggle -->
      <button
        class="theme-toggle"
        type="button"
        aria-label="Cambiar entre tema claro y oscuro"
      >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>

        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

    </div>
  </div>
</header>

<script>
  /**
   * Theme toggle
   */
  const boton = document.querySelector<HTMLButtonElement>('.theme-toggle');

  boton?.addEventListener('click', () => {
    const raiz = document.documentElement;

    const siguiente =
      raiz.dataset.theme === 'light'
        ? 'dark'
        : 'light';

    raiz.dataset.theme = siguiente;

    try {
      localStorage.setItem('nexus-theme', siguiente);
    } catch {
      // El tema sigue funcionando aunque localStorage esté bloqueado.
    }
  });


  /**
   * Mobile navigation
   */
  const menuToggle =
    document.getElementById('menu-toggle') as HTMLInputElement | null;

  document.querySelectorAll('.nav-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menuToggle) {
        menuToggle.checked = false;
      }
    });
  });
</script>

<style>
  /* =========================================================
     NAVBAR
     ========================================================= */

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    z-index: 100;

    background-color: var(--bg-primary);

    border-bottom: 1px solid var(--border-default);
  }

  .navbar-container {
    height: 84px;

    max-width: 1440px;
    margin: 0 auto;

    padding: 0 var(--gutter);

    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  /* =========================================================
     LOGO
     ========================================================= */

  .navbar-logo {
    position: relative;

    display: flex;
    align-items: center;

    color: var(--text-primary);
    text-decoration: none;

    flex-shrink: 0;
  }

  .logo {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;

    color: var(--text-primary);

    font-family: 'Public Stunt', sans-serif;
    font-size: 3.8rem;
    font-weight: 400;
    line-height: 1;

    letter-spacing: 0.02em;
  }

  .text-logo-nexus {
    display: block;
  }

  .sub-text-logo-nexus {
    position: absolute;

    top: 3.25rem;

    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.18em;

    color: var(--text-secondary);
  }


  /* =========================================================
     ACTIONS
     ========================================================= */

  .navbar-actions {
    display: flex;
    align-items: center;

    gap: 1.5rem;
  }


  /* =========================================================
     NAVIGATION
     ========================================================= */

  .navbar-nav {
    display: flex;
    align-items: center;
  }

  .nav-menu {
    display: flex;
    align-items: center;

    gap: 2rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .nav-menu li {
    display: flex;
    align-items: center;
  }

  .navbar-nav a {
    position: relative;

    color: var(--text-secondary);

    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;

    text-decoration: none;

    transition:
      color 0.2s ease;
  }

  .navbar-nav a:not(.button)::after {
    content: '';

    position: absolute;

    left: 0;
    bottom: -7px;

    width: 0;
    height: 1px;

    background-color: var(--accent-default);

    transition: width 0.2s ease;
  }

  .navbar-nav a:not(.button):hover {
    color: var(--text-primary);
  }

  .navbar-nav a:not(.button):hover::after {
    width: 100%;
  }


  /* =========================================================
     CTA
     ========================================================= */

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.5rem;

    min-height: 40px;

    padding: 0.65rem 1rem;

    border: 1px solid var(--accent-default);
    border-radius: 6px;

    background-color: var(--accent-default);
    color: #000 !important;

    font-family: 'Inter', sans-serif;
    font-size: 0.78rem !important;
    font-weight: 600 !important;

    text-decoration: none;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .button:hover {
    opacity: 0.9;

    transform: translateY(-1px);
  }

  .button span {
    font-size: 1rem;

    transition: transform 0.2s ease;
  }

  .button:hover span {
    transform: translate(2px, -2px);
  }


  /* =========================================================
     THEME TOGGLE
     ========================================================= */

  .theme-toggle {
    display: grid;
    place-items: center;

    width: 40px;
    height: 40px;

    padding: 0;

    border: 1px solid var(--border-default);
    border-radius: 7px;

    background-color: transparent;
    color: var(--text-secondary);

    cursor: pointer;

    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--text-primary);

    border-color: var(--text-secondary);

    background-color: rgba(255, 255, 255, 0.04);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent-default);
    outline-offset: 3px;
  }


  /* =========================================================
     THEME ICONS
     ========================================================= */

  .theme-toggle .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle .icon-sun {
    display: block;
  }

  :global([data-theme='light']) .theme-toggle .icon-moon {
    display: none;
  }


  /* =========================================================
     MOBILE MENU
     ========================================================= */

  .menu-toggle,
  .menu-icon {
    display: none;
  }


  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width: 900px) {

    .navbar-container {
      height: 72px;

      padding: 0 var(--gutter);
    }

    .logo {
      font-size: 2.4rem;
    }

    .sub-text-logo-nexus {
      top: 2.05rem;

      font-size: 0.52rem;
    }


    .navbar-actions {
      gap: 0.5rem;
    }


    /* Hamburger */

    .menu-icon {
      display: flex;

      width: 40px;
      height: 40px;

      align-items: center;
      justify-content: center;

      flex-direction: column;

      gap: 5px;

      cursor: pointer;
    }

    .menu-icon span {
      display: block;

      width: 22px;
      height: 2px;

      background-color: var(--text-primary);

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }


    /* Mobile menu */

    .nav-menu {
      display: none;

      position: absolute;

      top: 72px;
      left: 0;
      right: 0;

      flex-direction: column;
      align-items: stretch;

      gap: 1.25rem;

      padding: 1.5rem;

      background-color: var(--bg-primary);

      border-bottom: 1px solid var(--border-default);
    }

    .menu-toggle:checked ~ .nav-menu {
      display: flex;
    }


    .nav-menu li {
      width: 100%;
    }

    .nav-menu a:not(.button) {
      display: block;

      width: 100%;

      padding: 0.25rem 0;

      font-size: 0.95rem;
    }


    .nav-menu .button {
      width: 100%;
    }


    /* Hamburger animation */

    .menu-toggle:checked ~ .menu-icon span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media (max-width: 480px) {

    .navbar-container {
      padding: 0 1rem;
    }

    .logo {
      font-size: 2.1rem;
    }

    .sub-text-logo-nexus {
      top: 1.8rem;

      font-size: 0.46rem;
    }

    .theme-toggle {
      width: 38px;
      height: 38px;
    }

    .menu-icon {
      width: 38px;
      height: 38px;
    }
  }
</style>
