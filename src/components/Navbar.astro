---
const navItems = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Filosofía', href: '#mision' },
  { label: 'Método', href: '#metodo' },
  { label: 'Escuchamos', href: '#escuchanos' },
];
---

<header class="navbar">
  <div class="navbar-container">

    <!-- Logo -->
    <a href="/" class="navbar-logo" aria-label="NEXUS THRIVE">
      <span class="logo">
        <span class="text-logo-nexus">N</span>
        <span class="sub-text-logo-nexus">THRIVE</span>
      </span>
    </a>

    <!-- Acciones -->
    <div class="navbar-actions">

      <!-- Navegación -->
      <nav class="navbar-nav" aria-label="Navegación principal">

        <input
          type="checkbox"
          id="menu-toggle"
          class="menu-toggle"
          aria-hidden="true"
        />

        <label
          for="menu-toggle"
          class="menu-icon"
          aria-label="Abrir menú"
        >
          <span></span>
          <span></span>
          <span></span>
        </label>

        <ul class="nav-menu">
          {navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>

      </nav>

    </div>
  </div>
</header>

<script>
  /**
   * Mobile navigation: cierra el menú al tocar un enlace.
   */
  const menuToggle =
    document.getElementById('menu-toggle') as HTMLInputElement | null;

  document.querySelectorAll('.nav-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menuToggle) {
        menuToggle.checked = false;
      }
    });
  });
</script>

<style>
  /* =========================================================
     NAVBAR
     ========================================================= */

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    z-index: 100;

    background-color: var(--bg-primary);

    border-bottom: 1px solid var(--border-default);
  }

  .navbar-container {
    height: 84px;

    max-width: 1440px;
    margin: 0 auto;

    padding: 0 var(--gutter);

    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  /* =========================================================
     LOGO
     ========================================================= */

  .navbar-logo {
    position: relative;

    display: flex;
    align-items: center;

    min-width: 0;

    color: var(--text-primary);
    text-decoration: none;

    flex-shrink: 0;
  }

  .logo {
    position: relative;

    display: inline-block;

    color: var(--text-primary);

    font-family: 'Public Stunt', sans-serif;
    font-size: 3.8rem;
    font-weight: 400;
    line-height: 1;

    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .text-logo-nexus {
    display: block;

    line-height: 1;
  }

  .sub-text-logo-nexus {
    position: absolute;

    top: 3.25rem;
    left: 50%;

    transform: translateX(-50%);

    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.18em;
    white-space: nowrap;

    color: var(--text-secondary);
  }


  /* =========================================================
     ACTIONS
     ========================================================= */

  .navbar-actions {
    display: flex;
    align-items: center;

    gap: 1.5rem;
  }


  /* =========================================================
     NAVIGATION
     ========================================================= */

  .navbar-nav {
    display: flex;
    align-items: center;
  }

  .nav-menu {
    display: flex;
    align-items: center;

    gap: 2rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .nav-menu li {
    display: flex;
    align-items: center;
  }

  .navbar-nav a {
    position: relative;

    color: var(--text-secondary);

    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;

    text-decoration: none;

    transition:
      color 0.2s ease;
  }

  .navbar-nav a::after {
    content: '';

    position: absolute;

    left: 0;
    bottom: -7px;

    width: 0;
    height: 1px;

    background-color: var(--accent-default);

    transition: width 0.2s ease;
  }

  .navbar-nav a:hover {
    color: var(--text-primary);
  }

  .navbar-nav a:hover::after {
    width: 100%;
  }


  /* =========================================================
     MOBILE MENU
     ========================================================= */

  .menu-toggle,
  .menu-icon {
    display: none;
  }


  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width: 900px) {

    .navbar-container {
      height: 72px;

      padding: 0 var(--gutter);
    }

    .logo {
      font-size: 2.4rem;
    }

    .sub-text-logo-nexus {
      top: 2.05rem;

      font-size: 0.52rem;
    }


    .navbar-actions {
      gap: 0.5rem;
    }


    /* Hamburger */

    .menu-icon {
      display: flex;

      width: 40px;
      height: 40px;

      align-items: center;
      justify-content: center;

      flex-direction: column;

      gap: 5px;

      cursor: pointer;
    }

    .menu-icon span {
      display: block;

      width: 22px;
      height: 2px;

      background-color: var(--text-primary);

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }


    /* Mobile menu: panel flotante con blur, elegante y táctil */

    .nav-menu {
      display: none;

      position: absolute;

      top: 72px;
      left: 0;
      right: 0;

      flex-direction: column;
      align-items: stretch;

      gap: 0;

      padding: 0.4rem var(--gutter) 0.8rem;

      background-color:
        color-mix(
          in srgb,
          var(--bg-primary) 88%,
          transparent
        );

      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);

      border-bottom: 1px solid var(--border-default);

      box-shadow: 0 28px 60px rgba(0, 0, 0, 0.14);
    }

    .menu-toggle:checked ~ .nav-menu {
      display: flex;
    }


    .nav-menu li {
      width: 100%;

      border-bottom: 1px solid var(--border-default);
    }

    .nav-menu li:last-child {
      border-bottom: none;
    }

    .nav-menu a {
      display: block;

      width: 100%;

      padding: 0.95rem 0.15rem;

      font-size: 1rem;
    }

    .nav-menu a::after {
      display: none;
    }

    .nav-menu a:hover {
      color: var(--accent-text, var(--accent-default));
    }


    /* Hamburger animation */

    .menu-toggle:checked ~ .menu-icon span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media (max-width: 480px) {

    .navbar-container {
      padding: 0 1rem;
    }

    .logo {
      font-size: 2.1rem;
    }

    .sub-text-logo-nexus {
      top: 1.8rem;

      font-size: 0.46rem;
    }

    .menu-icon {
      width: 38px;
      height: 38px;
    }
  }
</style>
