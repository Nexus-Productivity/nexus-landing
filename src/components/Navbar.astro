---
const navItems = [
  { label: 'La ruta', href: '#ruta', id: 'ruta' },
  { label: 'Precios', href: '#precios', id: 'precios' },
  { label: 'Trabajo real', href: '#proyectos', id: 'proyectos' },
  { label: 'Método', href: '#metodo', id: 'metodo' },
  { label: 'Sobre Nexus', href: '#mision', id: 'mision' },
  { label: 'Preguntas', href: '#faq', id: 'faq' },
  { label: 'Contacto', href: '#escuchanos', id: 'escuchanos', accent: true },
];
---

<header class="navbar" id="navbar">
  <div class="navbar-container">

    <!-- Logo -->
    <a href="/" class="navbar-logo" aria-label="NEXUS THRIVE — inicio">
      <span class="logo">
        <span class="text-logo-nexus">N</span>
        <span class="sub-text-logo-nexus">THRIVE</span>
      </span>
    </a>

    <!-- Navegación -->
    <nav class="navbar-nav" aria-label="Navegación principal">

      <input
        type="checkbox"
        id="menu-toggle"
        class="menu-toggle"
        aria-hidden="true"
      />

      <label
        for="menu-toggle"
        class="menu-icon"
        aria-label="Abrir menú"
      >
        <span></span>
        <span></span>
        <span></span>
      </label>

      <ul class="nav-menu">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-section={item.id}
              class:list={[{ 'is-accent': item.accent }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

    </nav>

  </div>
</header>

<script>
  /**
   * Navbar con estados:
   *
   * 1. .is-scrolled — al bajar, la barra pasa de transparente a
   *    panel esmerilado (blur + borde + sombra sutil).
   *
   * 2. Scroll-spy — la sección visible queda marcada en el menú
   *    (.is-active + aria-current) vía IntersectionObserver.
   *
   * 3. Móvil — cierra el menú al tocar un enlace.
   */

  const navbar = document.getElementById('navbar');

  /* --- 1. Fondo esmerilado al hacer scroll --- */
  const actualizarScroll = () => {
    navbar?.classList.toggle('is-scrolled', window.scrollY > 12);
  };

  actualizarScroll();
  window.addEventListener('scroll', actualizarScroll, { passive: true });


  /* --- 2. Scroll-spy --- */
  const enlaces = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.nav-menu a[data-section]')
  );

  const porSeccion = new Map(
    enlaces.map((enlace) => [enlace.dataset.section as string, enlace])
  );

  const marcarActivo = (id: string) => {
    enlaces.forEach((enlace) => {
      const activo = enlace.dataset.section === id;
      enlace.classList.toggle('is-active', activo);

      if (activo) {
        enlace.setAttribute('aria-current', 'true');
      } else {
        enlace.removeAttribute('aria-current');
      }
    });
  };

  if ('IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting && porSeccion.has(entrada.target.id)) {
            marcarActivo(entrada.target.id);
          }
        });
      },
      {
        /* Activo cuando la sección cruza la franja central del viewport */
        rootMargin: '-40% 0px -55% 0px',
      }
    );

    porSeccion.forEach((_, id) => {
      const seccion = document.getElementById(id);
      if (seccion) observador.observe(seccion);
    });
  }


  /* --- 3. Cerrar menú móvil al navegar --- */
  const menuToggle =
    document.getElementById('menu-toggle') as HTMLInputElement | null;

  enlaces.forEach((link) => {
    link.addEventListener('click', () => {
      if (menuToggle) {
        menuToggle.checked = false;
      }
    });
  });
</script>

<style>
  /* =========================================================
     NAVBAR — transparente arriba, esmerilada al bajar
     ========================================================= */

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    z-index: 100;

    background-color: transparent;

    border-bottom: 1px solid transparent;

    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .navbar.is-scrolled {
    background-color:
      color-mix(
        in srgb,
        var(--bg-primary) 82%,
        transparent
      );

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom-color: var(--border-default);

    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
  }

  .navbar-container {
    height: 76px;

    max-width: 1440px;
    margin: 0 auto;

    padding: 0 var(--gutter);

    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  /* =========================================================
     LOGO
     ========================================================= */

  .navbar-logo {
    position: relative;

    display: flex;
    align-items: center;

    color: var(--text-primary);
    text-decoration: none;

    flex-shrink: 0;
  }

  .logo {
    position: relative;

    display: inline-block;

    color: var(--text-primary);

    font-family: 'Public Stunt', sans-serif;
    font-size: 3.6rem;
    font-weight: 400;
    line-height: 1;

    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .text-logo-nexus {
    display: block;

    line-height: 1;
  }

  .sub-text-logo-nexus {
    position: absolute;

    top: 3.1rem;
    left: 50%;

    transform: translateX(-50%);

    font-family: 'Montserrat', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;

    letter-spacing: 0.2em;
    white-space: nowrap;

    color: var(--text-secondary);
  }


  /* =========================================================
     NAVEGACIÓN
     ========================================================= */

  .navbar-nav {
    display: flex;
    align-items: center;
  }

  .nav-menu {
    display: flex;
    align-items: center;

    gap: 1.9rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .nav-menu li {
    display: flex;
    align-items: center;
  }

  .navbar-nav a {
    position: relative;

    padding: 0.3rem 0;

    color: var(--text-secondary);

    font-family: 'Inter', sans-serif;
    font-size: 0.86rem;
    font-weight: 500;

    letter-spacing: 0.01em;

    text-decoration: none;

    transition:
      color 0.2s ease;
  }

  /* Subrayado animado (hover + sección activa) */
  .navbar-nav a::after {
    content: '';

    position: absolute;

    left: 0;
    bottom: -2px;

    width: 100%;
    height: 1.5px;

    background-color: var(--accent-default);

    transform: scaleX(0);
    transform-origin: left;

    transition: transform 0.25s ease;
  }

  .navbar-nav a:hover {
    color: var(--text-primary);
  }

  .navbar-nav a:hover::after,
  .navbar-nav a.is-active::after {
    transform: scaleX(1);
  }

  .navbar-nav a.is-active {
    color: var(--text-primary);

    font-weight: 600;
  }

  /* Contacto: acento dorado, siempre visible */
  .navbar-nav a.is-accent {
    color: var(--accent-text, var(--accent-default));

    font-weight: 600;
  }

  .navbar-nav a.is-accent:hover,
  .navbar-nav a.is-accent.is-active {
    color: var(--accent-pressed, var(--accent-default));
  }


  /* =========================================================
     MOBILE MENU (oculto en desktop)
     ========================================================= */

  .menu-toggle,
  .menu-icon {
    display: none;
  }


  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width: 900px) {

    .navbar-container {
      height: 68px;

      padding: 0 var(--gutter);
    }

    .logo {
      font-size: 2.4rem;
    }

    .sub-text-logo-nexus {
      top: 2.05rem;

      font-size: 0.52rem;
    }


    /* Hamburger */

    .menu-icon {
      display: flex;

      width: 42px;
      height: 42px;

      align-items: center;
      justify-content: center;

      flex-direction: column;

      gap: 5px;

      border: 1px solid var(--border-default);
      border-radius: 9px;

      background-color:
        color-mix(
          in srgb,
          var(--bg-primary) 65%,
          transparent
        );

      cursor: pointer;

      transition:
        border-color 0.2s ease;
    }

    .menu-icon:hover {
      border-color: var(--text-secondary);
    }

    .menu-icon span {
      display: block;

      width: 20px;
      height: 2px;

      border-radius: 2px;

      background-color: var(--text-primary);

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }


    /* Menú desplegable */

    .nav-menu {
      display: none;

      position: absolute;

      top: 68px;
      left: 0;
      right: 0;

      flex-direction: column;
      align-items: stretch;

      gap: 0;

      padding: 0.4rem var(--gutter) 0.8rem;

      background-color:
        color-mix(
          in srgb,
          var(--bg-primary) 92%,
          transparent
        );

      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);

      border-bottom: 1px solid var(--border-default);

      box-shadow: 0 28px 60px rgba(0, 0, 0, 0.12);
    }

    .menu-toggle:checked ~ .nav-menu {
      display: flex;
    }


    .nav-menu li {
      width: 100%;

      border-bottom: 1px solid var(--border-default);
    }

    .nav-menu li:last-child {
      border-bottom: none;
    }

    .nav-menu a {
      display: block;

      width: 100%;

      padding: 0.95rem 0.15rem;

      font-size: 1rem;
    }

    .nav-menu a::after {
      display: none;
    }

    .nav-menu a:hover {
      color: var(--accent-text, var(--accent-default));
    }

    .nav-menu a.is-active {
      color: var(--accent-text, var(--accent-default));
    }


    /* Hamburguesa → X */

    .menu-toggle:checked ~ .menu-icon span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media (max-width: 480px) {

    .navbar-container {
      padding: 0 1rem;
    }

    .logo {
      font-size: 2.1rem;
    }

    .sub-text-logo-nexus {
      top: 1.8rem;

      font-size: 0.46rem;
    }

    .menu-icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
