---
import starUrl from '../assets/star.svg?url';

const navItems = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Filosofía', href: '#mision' },
  { label: 'Método', href: '#metodo' },
  { label: 'Escuchamos', href: '#escuchanos' },
];
---

<div class="top-banner">Estamos construyendo NEXUS!</div>

<header class="navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-logo">
      <img class="logo-star" src={starUrl} alt="Estrella Nexus" />
      <span class="logo">NEXUS</span>
    </a>
    <nav class="navbar-nav">
      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" />
      <label for="menu-toggle" class="menu-icon" aria-label="Abrir menú">
        <span></span>
        <span></span>
        <span></span>
      </label>
      <ul class="nav-menu">
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><button class="button">Explorar Proyectos</button></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .top-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--accent-default);
    color: #000;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    padding: 0 1rem;
  }

  .navbar {
    position: fixed;
    top: 36px;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--bg-primary);
  }

  .navbar-container {
    height: 150px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo-star {
    position: absolute;
    top: -52px;
    right: 88px;
    height: 160px;
    width: auto;
    transform: rotate(-19deg);
    z-index: 0;
  }

  .logo {
    position: relative;
    z-index: 1;
    font-family: 'Public Stunt', sans-serif;
    font-size: 2.1rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .menu-toggle,
  .menu-icon {
    display: none;
  }

  .nav-menu {
    display: flex;
    gap: 2rem;
    list-style: none;
    align-items: center;
  }

  .navbar-nav a {
    color: var(--text-secondary);
    font-family: "Inter", sans-serif;
    font-weight: 400;
    transition: color 0.2s ease;
  }

  .navbar-nav a:hover {
    color: var(--accent-default);
  }

  .button {
    font-family: "Inter", sans-serif;
    font-weight: 500;
    background-color: var(--accent-default);
    padding: 10px 18px;
    border-radius: 5px;
    border: none;
    cursor: pointer;
  }

  /* --- Responsive móvil: barra compacta + menú hamburguesa --- */
  @media (max-width: 900px) {
    .navbar-container {
      height: 72px;
      padding: 0.5rem 1.25rem;
    }

    .logo-star {
      top: -22px;
      right: 44px;
      height: 72px;
    }

    .logo {
      font-size: 1.5rem;
    }

    .menu-icon {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      padding: 8px 4px;
    }

    .menu-icon span {
      display: block;
      width: 24px;
      height: 2px;
      background-color: var(--text-primary);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      background-color: var(--bg-primary);
      border-bottom: 1px solid var(--border-default);
      padding: 1.25rem 1.5rem 1.75rem;
    }

    .menu-toggle:checked ~ .nav-menu {
      display: flex;
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle:checked ~ .menu-icon span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-menu .button {
      align-self: flex-start;
    }
  }
</style>

<script>
  // En móvil: cerrar el menú hamburguesa al elegir una opción
  const menuToggle = document.getElementById('menu-toggle');
  document.querySelectorAll('.nav-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menuToggle) menuToggle.checked = false;
    });
  });
</script>
