---
import Logo from './Logo.astro';
import { whatsappUrl, instagramUrl, instagramTexto, email, githubUrl } from '../data/contacto';
import { marca, promesa } from '../data/oferta';

const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="md" />
        <p class="footer-promise">{promesa}</p>
      </div>

      <div class="footer-col">
        <h2 class="footer-title">Contacto</h2>
        <a class="footer-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
        {email && <a class="footer-link" href={`mailto:${email}`}>{email}</a>}
      </div>

      <div class="footer-col">
        <h2 class="footer-title">Redes</h2>
        {instagramUrl && (
          <a class="footer-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">
            {instagramTexto}
          </a>
        )}
        <a class="footer-link" href={githubUrl} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {anio} {marca}</span>

      <!--
        ⚠️ PENDIENTE LEGAL — el footer de una web en Colombia necesita
        razón social y NIT visibles (art. 50, Ley 1480 de 2011), enlace
        a la SIC y canal PQR. Hoy NEXUS no está constituido, así que no
        hay datos que poner. Cuando se constituya la S.A.S. (o se
        defina la entidad), se agrega acá.
      -->
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(3rem, 6vw, 4.5rem) 0 2rem;
    background-color: var(--bg-deep);
    color: #ffffff;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  /* `minmax(0, 1fr)` y no `1fr`: la fracción sola usa el ancho MÁXIMO
     del contenido como mínimo, así que la columna del logo (que trae un
     `white-space: nowrap` en el wordmark) se negaba a encogerse y
     empujaba el footer fuera del viewport por debajo de ~360px. El `0`
     como mínimo le permite bajar. */
  @media (min-width: 700px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  /* Igual en mobile: una sola columna, pero que pueda encogerse. */
  .footer-grid > * {
    min-width: 0;
  }

  /* El logo es negro sobre fondo negro: en el footer va en blanco */
  .footer-brand :global(.logo-wordmark) {
    color: #ffffff;
  }

  .footer-promise {
    margin-top: 1.1rem;
    max-width: 34ch;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-title {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-default);
  }

  .footer-link {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    width: fit-content;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent-default);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--accent-default);
  }
</style>