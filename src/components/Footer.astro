---
const WHATSAPP = '573237453913';

const waText = encodeURIComponent(
  'Hola NEXUS THRIVE, vengo del sitio web.'
);
const waHref = `https://wa.me/${WHATSAPP}?text=${waText}`;

const navGroups = [
  {
    title: 'Navegación',
    links: [
      { label: 'La ruta', href: '#ruta' },
      { label: 'Precios', href: '#precios' },
      { label: 'Trabajo real', href: '#proyectos' },
      { label: 'Cómo trabajamos', href: '#metodo' },
      { label: 'Preguntas', href: '#faq' },
    ],
  },
  {
    title: 'Contacto',
    links: [
      { label: 'WhatsApp', href: waHref, external: true },
      { label: 'hola@nexusthrive.com.co', href: 'mailto:hola@nexusthrive.com.co' },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-container">

    <div class="footer-main">

      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="NEXUS THRIVE — inicio">
          <span class="logo-n">N</span>
          <span class="logo-sub">THRIVE</span>
        </a>

        <p class="footer-tagline">
          Negocios visibles, conectados y ordenados.
        </p>

        <div class="footer-facts">
          <span class="fact">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Cartagena, Colombia
          </span>
          <span class="fact">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M2 12h20"></path>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            Español
          </span>
        </div>
      </div>

      {navGroups.map((group) => (
        <nav class="footer-column" aria-label={group.title}>
          <span class="footer-column-title">{group.title}</span>
          <ul role="list">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.external
                    ? { target: '_blank', rel: 'noopener' }
                    : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <nav class="footer-column" aria-label="Social">
        <span class="footer-column-title">Social</span>
        <ul role="list">
          <li>
            <a href="https://github.com/Nexus-Productivity" target="_blank" rel="noopener">
              GitHub
            </a>
          </li>
        </ul>
      </nav>

    </div>

    <div class="footer-bottom">
      <span>© 2026 NEXUS THRIVE. Todos los derechos reservados.</span>

      <div class="footer-legal">
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-default);

    background: var(--bg-deep, transparent);

    padding: 0 var(--gutter);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---------- Principal ---------- */

  .footer-main {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);

    padding: clamp(3rem, 6vw, 4.5rem) 0;
  }

  /* ---------- Marca ---------- */

  .footer-logo {
    position: relative;

    display: inline-flex;
    flex-direction: column;

    width: fit-content;

    margin-bottom: 1rem;

    color: var(--text-primary);

    font-family: 'Public Stunt', sans-serif;
    font-size: 2.4rem;
    line-height: 1;
  }

  .footer-logo:hover {
    color: var(--text-primary);
  }

  .logo-sub {
    position: absolute;
    top: 2.1rem;

    font-family: 'Montserrat', sans-serif;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.18em;

    color: var(--text-secondary);
  }

  .footer-tagline {
    margin: 1.1rem 0 1.4rem;

    max-width: 280px;

    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    line-height: 1.6;

    color: var(--text-secondary);
  }

  .footer-facts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;

    color: var(--text-muted);
  }

  .fact svg {
    color: var(--accent-text, var(--accent-default));
  }

  /* ---------- Columnas ---------- */

  .footer-column-title {
    display: block;

    margin-bottom: 1.1rem;

    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    color: var(--text-muted);
  }

  .footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .footer-column a {
    width: fit-content;

    font-family: 'Inter', sans-serif;
    font-size: 0.87rem;

    color: var(--text-secondary);

    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    color: var(--accent-text, var(--accent-default));
  }

  /* ---------- Barra inferior ---------- */

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    padding: 1.5rem 0 1.8rem;

    border-top: 1px solid var(--border-default);

    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;

    color: var(--text-muted);
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal a {
    color: var(--text-muted);

    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--accent-text, var(--accent-default));
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 768px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.9rem;

      text-align: center;
    }
  }
</style>
