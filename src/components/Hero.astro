---
import grainientWebmUrl from '../assets/grainient-white-vp9.webm?url';
import grainientMp4Url from '../assets/grainient-white-vp9.mp4?url';
import grainientPosterUrl from '../assets/grainient-white-poster.jpg?url';

const WHATSAPP = '573237453913';

const waText = encodeURIComponent(
  'Hola NEXUS THRIVE, quiero mi radiografía gratis.'
);

const waHref = `https://wa.me/${WHATSAPP}?text=${waText}`;


const trust = [
  { text: 'Sitio en producción: casapozonmuseo.org', href: 'https://casapozonmuseo.org' },
  { text: 'Todo por escrito' },
  { text: 'Propuesta sin compromiso' },
];
---

<section class="hero" style={`background-image: url(${grainientPosterUrl})`}>

  <!-- =====================================================
       BACKGROUND
       ===================================================== -->

  <!--
    Un solo video (versión clara: el tema por defecto es claro).

    Móvil/Safari: iOS no reproduce WebM/VP9 en <video>, por eso hay
    fallback MP4 (H.264). El `poster` cubre el arranque y el caso
    de autoplay bloqueado (modo ahorro de batería) para que nunca
    se vea un recuadro negro.
  -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={grainientPosterUrl}
    disablepictureinpicture
    disableremoteplayback
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={grainientWebmUrl} type="video/webm" />
    <source src={grainientMp4Url} type="video/mp4" />
  </video>

  <div class="hero-overlay" aria-hidden="true"></div>


  <!-- =====================================================
       MAIN CONTENT
       ===================================================== -->

  <div class="hero-inner">

    <div class="hero-content">

      <div class="hero-eyebrow">
        <span class="eyebrow-line"></span>
        NEXUS THRIVE
        <span class="eyebrow-separator">/</span>
        Turbaco y Cartagena
      </div>


      <h1 class="hero-title">
        Que te encuentren,
        <span>que te escriban.</span>
      </h1>


      <p class="hero-description">
        Te devolvemos tiempo, orden y claridad: un sitio que
        trabaja por ti y un método claro para que sepas qué
        pasa con tu operación.
      </p>


      <div class="hero-actions">

        <a
          href={waHref}
          class="hero-primary"
          target="_blank"
          rel="noopener"
          data-cta="whatsapp-hero"
        >
          <span>Pedir mi radiografía gratis</span>

          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>


        <a href="#metodo" class="hero-secondary">
          Ver nuestro método
        </a>

      </div>


      <ul class="hero-trust">
        {trust.map((item) => (
          <li>
            <span class="trust-dot"></span>
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener" style="color: inherit; text-decoration: underline; text-underline-offset: 3px;">{item.text}</a>
            ) : (
              item.text
            )}
          </li>
        ))}
      </ul>

    </div>



  </div>


  <!-- =====================================================
       SCROLL INDICATOR
       ===================================================== -->

  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>

    <span class="scroll-line"></span>
  </div>

</section>


<style>

  /* =========================================================
     HERO
     ========================================================= */

  .hero {
    position: relative;

    background-size: cover;
    background-position: center;

    min-height: 100svh;

    display: flex;
    align-items: center;

    overflow: hidden;

    isolation: isolate;

    padding:
      9rem
      var(--gutter)
      5rem;
  }


  /* =========================================================
     BACKGROUND
     ========================================================= */

  .hero-video {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    z-index: -3;

    opacity: 0.75;

    pointer-events: none;
  }


  /* =========================================================
     OVERLAY
     ========================================================= */

  .hero-overlay {
    position: absolute;

    inset: 0;

    z-index: -2;

    pointer-events: none;

    background:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.88) 0%,
        rgba(255, 255, 255, 0.55) 45%,
        rgba(255, 255, 255, 0.12) 78%,
        rgba(255, 255, 255, 0.3) 100%
      ),
      linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.5) 0%,
        rgba(255, 255, 255, 0) 60%
      );
  }


  /* Tema oscuro (si algún día vuelve el toggle) */
  :global([data-theme='dark']) .hero-overlay {
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.5) 42%,
        rgba(0, 0, 0, 0.15) 75%,
        rgba(0, 0, 0, 0.25) 100%
      ),
      linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.65) 0%,
        rgba(0, 0, 0, 0.05) 55%
      );
  }


  /* =========================================================
     INNER
     ========================================================= */

  .hero-inner {
    width: 100%;
    max-width: 1440px;

    margin: 0 auto;

    display: grid;

    grid-template-columns: minmax(0, 760px);

    align-items: center;

    justify-content: center;

    text-align: center;
  }


  /* =========================================================
     CONTENT
     ========================================================= */

  .hero-content {
    max-width: 760px;

    margin: 0 auto;

    text-align: center;
  }


  /* =========================================================
     EYEBROW
     ========================================================= */

  .hero-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 0.6rem;

    margin-bottom: 1.6rem;

    font-family: 'Inter', sans-serif;

    font-size: 0.7rem;
    font-weight: 600;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .eyebrow-line {
    width: 24px;
    height: 1px;

    background: var(--accent-default);
  }

  .eyebrow-separator {
    opacity: 0.4;
  }


  /* =========================================================
     TITLE
     ========================================================= */

  .hero-title {
    max-width: 700px;

    margin: 0;

    font-family: 'Space Grotesk', sans-serif;

    font-size: clamp(
      2.6rem,
      5vw,
      4.4rem
    );

    font-weight: 500;

    line-height: 0.98;

    letter-spacing: -0.055em;

    color: var(--text-primary);
  }

  .hero-title span {
    display: block;

    color: var(--accent-default);

    text-shadow:
      0 0 35px var(--glow-text),
      0 0 80px var(--glow-text);
  }

  :global([data-theme='light']) .hero-title span {
    color: var(--accent-text, #80651d);
  }


  /* =========================================================
     DESCRIPTION
     ========================================================= */

  .hero-description {
    max-width: 600px;

    margin: 1.6rem auto 2.2rem;

    font-family: 'Inter', sans-serif;

    font-size: clamp(
      1rem,
      1.4vw,
      1.18rem
    );

    line-height: 1.65;

    color: var(--text-secondary);
  }


  /* =========================================================
     ACTIONS
     ========================================================= */

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 0.75rem;
  }


  .hero-primary,
  .hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.65rem;

    min-height: 48px;

    padding: 0 1.25rem;

    border-radius: 7px;

    font-family: 'Inter', sans-serif;

    font-size: 0.84rem;
    font-weight: 600;

    text-decoration: none;

    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }


  .hero-primary {
    background: var(--accent-default);

    border: 1px solid var(--accent-default);

    color: #050505;
  }

  .hero-primary:hover {
    transform: translateY(-2px);

    box-shadow:
      0 12px 35px rgba(212, 175, 55, 0.2);
  }

  .hero-primary svg {
    transition: transform 0.2s ease;
  }

  .hero-primary:hover svg {
    transform: translateX(3px);
  }


  .hero-secondary {
    border: 1px solid var(--border-default);

    color: var(--text-primary);

    background: rgba(255, 255, 255, 0.025);
  }

  .hero-secondary:hover {
    border-color: var(--accent-default);

    color: var(--accent-text, var(--accent-default));

    transform: translateY(-2px);
  }


  /* =========================================================
     TRUST
     ========================================================= */

  .hero-trust {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 0.6rem 1.5rem;

    margin: 1.7rem 0 0;

    padding: 0;

    list-style: none;

    font-family: 'Inter', sans-serif;

    font-size: 0.75rem;

    color: var(--text-secondary);
  }

  .hero-trust li {
    display: flex;
    align-items: center;

    gap: 0.45rem;
  }

  .trust-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--accent-default);
  }


  /* =========================================================
     SCROLL
     ========================================================= */

  .hero-scroll {
    position: absolute;

    left: 50%;
    bottom: 1.6rem;

    transform: translateX(-50%);

    display: flex;
    align-items: center;
    flex-direction: column;

    gap: 0.55rem;

    font-family: 'Inter', sans-serif;

    font-size: 0.6rem;
    font-weight: 500;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--text-muted);
  }

  .scroll-line {
    width: 1px;
    height: 42px;

    transform-origin: top center;

    background:
      linear-gradient(
        to bottom,
        var(--accent-default),
        transparent
      );

    animation: scroll-pulse 1.8s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0% {
      transform: scaleY(0);
      opacity: 0;
    }
    40% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1) translateY(8px);
      opacity: 0;
    }
  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .hero-video {
      display: none;
    }

    .scroll-line {
      animation: none;
    }

    .hero-primary,
    .hero-secondary {
      transition: none;
    }
  }


  /* =========================================================
     TABLET / MOBILE
     ========================================================= */

  @media (max-width: 900px) {

    .hero {
      min-height: auto;

      padding:
        8.5rem
        var(--gutter)
        4rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;

      gap: 3rem;
    }

    .hero-content {
      max-width: 720px;

      text-align: center;

      margin: 0 auto;
    }

    .hero-eyebrow {
      justify-content: center;
    }

    .hero-title {
      font-size: clamp(
        3rem,
        10vw,
        5rem
      );

      text-wrap: balance;
    }

    .hero-description {
      text-wrap: pretty;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-trust {
      justify-content: center;
    }


    .hero-scroll {
      display: none;
    }

    .hero-overlay {
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.55) 0%,
          rgba(255, 255, 255, 0.82) 100%
        );
    }

    :global([data-theme='dark']) .hero-overlay {
      background:
        linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.55) 0%,
          rgba(0, 0, 0, 0.75) 100%
        );
    }
  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media (max-width: 480px) {

    .hero {
      padding:
        8rem
        1rem
        3rem;
    }

    .hero-eyebrow {
      font-size: 0.58rem;

      letter-spacing: 0.1em;
    }

    .hero-title {
      font-size: clamp(
        2.65rem,
        13vw,
        4rem
      );

      letter-spacing: -0.045em;
    }

    .hero-description {
      font-size: 0.92rem;
    }

    .hero-actions {
      flex-direction: column;

      width: 100%;
    }

    .hero-primary,
    .hero-secondary {
      width: 100%;
    }

    .hero-trust {
      flex-direction: column;

      gap: 0.65rem;
    }

  }

</style>
