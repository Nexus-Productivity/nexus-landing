---
const services = [
  {
    n: '01',
    name: 'Software',
    tagline: 'Sistemas que trabajan para ti',
    text: 'Aplicaciones web, portales, dashboards y sistemas internos diseñados alrededor de tu operación, no al revés.',
    includes: [
      'Aplicaciones web y portales',
      'Sistemas internos y dashboards',
      'APIs e integraciones',
    ],
    icon: 'code',
  },
  {
    n: '02',
    name: 'Automatización',
    tagline: 'Menos tareas repetitivas',
    text: 'Conectamos las herramientas que ya usas para que la información fluya sola y tu equipo se enfoque en lo importante.',
    includes: [
      'Workflows e integraciones',
      'Procesamiento de información con IA',
      'Automatización administrativa',
    ],
    icon: 'workflow',
  },
  {
    n: '03',
    name: 'Infraestructura',
    tagline: 'Base sólida, siempre activa',
    text: 'Servidores, cloud y despliegues con monitorización: tu sistema disponible cuando lo necesitas, no cuando se puede.',
    includes: [
      'Servidores y cloud',
      'Docker y deployments',
      'Monitorización y alertas',
    ],
    icon: 'server',
  },
  {
    n: '04',
    name: 'Seguridad',
    tagline: 'Protegido por diseño',
    text: 'Accesos, credenciales, backups y redes manejados con criterio profesional desde el primer día.',
    includes: [
      'Control de accesos y secretos',
      'Backups y recuperación',
      'Hardening y protección de redes',
    ],
    icon: 'shield',
  },
];

const stack = [
  'Astro',
  'React',
  'Node.js',
  'APIs',
  'PostgreSQL',
  'Docker',
  'Linux',
  'Cloudflare',
  'Tailscale',
  'n8n',
  'IA',
];

const icons: Record<string, string> = {
  code: '<path d="m16 18 6-6-6-6"></path><path d="m8 6-6 6 6 6"></path>',
  workflow: '<rect x="3" y="3" width="6" height="6" rx="1"></rect><rect x="15" y="15" width="6" height="6" rx="1"></rect><path d="M9 6h6a3 3 0 0 1 3 3v6"></path><path d="M15 18H9a3 3 0 0 1-3-3V9"></path>',
  server: '<rect x="2" y="3" width="20" height="7" rx="2"></rect><rect x="2" y="14" width="20" height="7" rx="2"></rect><path d="M6 6.5h.01"></path><path d="M6 17.5h.01"></path>',
  shield: '<path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"></path><path d="m9 11.5 2 2 4-4.5"></path>',
};
---

<section class="servicios" id="servicios" aria-labelledby="servicios-title">
  <div class="servicios-container">

    <header class="servicios-header">
      <div class="eyebrow">
        <span class="eyebrow-line"></span>
        Soluciones
      </div>

      <h2 id="servicios-title" class="servicios-title">
        Servicios para operar
        <span>mejor, no para comprar más software.</span>
      </h2>

      <p class="servicios-lead">
        Cada servicio resuelve un problema concreto de tu operación.
        Se contratan por separado o como un sistema completo.
      </p>
    </header>

    <div class="servicios-grid">
      {services.map((service) => (
        <article class="service-card">

          <div class="service-top">
            <span class="service-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[service.icon]} />
            </span>
            <span class="service-number">{service.n}</span>
          </div>

          <h3>{service.name}</h3>
          <p class="service-tagline">{service.tagline}</p>
          <p class="service-text">{service.text}</p>

          <ul class="service-includes" role="list">
            {service.includes.map((item) => (
              <li>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <a href="#escuchanos" class="service-link">
            <span>Explorar solución</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>

        </article>
      ))}
    </div>

    <div class="servicios-stack">
      <span class="stack-label">Stack con el que construimos</span>

      <ul class="stack-list" role="list">
        {stack.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .servicios {
    padding: clamp(5rem, 10vw, 8.5rem) var(--gutter);
  }

  .servicios-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---------- Header ---------- */

  .servicios-header {
    max-width: 680px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;

    margin-bottom: 1.2rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .eyebrow-line {
    width: 24px;
    height: 1px;
    background: var(--accent-default);
  }

  .servicios-title {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;

    color: var(--text-primary);
  }

  .servicios-title span {
    display: block;
    color: var(--accent-default);
  }

  :global([data-theme='light']) .servicios-title span {
    color: var(--accent-text, #80651d);
  }

  .servicios-lead {
    margin: 1.2rem 0 0;

    font-family: 'Inter', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.65;

    color: var(--text-secondary);
  }

  /* ---------- Grid ---------- */

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .service-card {
    display: flex;
    flex-direction: column;

    padding: 1.9rem 1.7rem;

    border: 1px solid var(--border-default);
    border-radius: 14px;

    background: var(--bg-surface, rgba(255, 255, 255, 0.02));

    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .service-card:hover {
    border-color: rgba(212, 175, 55, 0.35);
    transform: translateY(-3px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.1);
  }

  .service-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 1.3rem;
  }

  .service-icon {
    display: grid;
    place-items: center;

    width: 46px;
    height: 46px;

    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 11px;

    background: rgba(212, 175, 55, 0.08);

    color: var(--accent-text, var(--accent-default));
  }

  .service-number {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;

    color: var(--text-muted);
  }

  .service-card h3 {
    margin: 0;

    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;

    color: var(--text-primary);
  }

  .service-tagline {
    margin: 0.3rem 0 0.9rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: var(--accent-text, var(--accent-default));
  }

  .service-text {
    margin: 0 0 1.3rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.87rem;
    line-height: 1.6;

    color: var(--text-secondary);
  }

  .service-includes {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;

    margin: 0 0 1.6rem;
    padding: 1.1rem 0 0;

    border-top: 1px solid var(--border-default);

    list-style: none;
  }

  .service-includes li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;

    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    line-height: 1.5;

    color: var(--text-secondary);
  }

  .service-includes svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--accent-default);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    width: fit-content;

    margin-top: auto;

    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;

    color: var(--text-primary);

    transition:
      color 0.2s ease,
      gap 0.2s ease;
  }

  .service-link:hover {
    color: var(--accent-text, var(--accent-default));
    gap: 0.75rem;
  }

  /* ---------- Stack ---------- */

  .servicios-stack {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;

    margin-top: 2.5rem;
    padding-top: 1.6rem;

    border-top: 1px solid var(--border-default);
  }

  .stack-label {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    color: var(--text-muted);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .stack-list li {
    padding: 0.3rem 0.7rem;

    border: 1px solid var(--border-default);
    border-radius: 999px;

    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;

    color: var(--text-secondary);

    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .stack-list li:hover {
    border-color: rgba(212, 175, 55, 0.4);
    color: var(--accent-text, var(--accent-default));
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 760px) {
    .servicios-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
